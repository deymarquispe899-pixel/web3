@model Prestamo
@{
    ViewData["Title"] = "Nuevo préstamo";
}
<h2>Registrar préstamo</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Libro</label>
        <select name="LibroId" class="form-select" asp-items="ViewBag.Libros">
            <option value="">-- Seleccione un libro --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <select name="UsuarioId" class="form-select" asp-items="ViewBag.Usuarios">
            <option value="">-- Seleccione un usuario --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="FechaPrestamo" class="form-label"></label>
        <input asp-for="FechaPrestamo" class="form-control" type="date" />
    </div>
    <div class="mb-3">
        <label asp-for="FechaDevolucionEsperada" class="form-label"></label>
        <input asp-for="FechaDevolucionEsperada" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Registrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
