<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca UV Sucre</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Biblioteca UV Sucre</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>

                            @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a></li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                            }
                            @if (User.IsInRole("Usuario"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Libros" asp-action="Catalogo">Catálogo</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Prestamos" asp-action="MisPrestamos">Mis préstamos</a></li>
                            }
                        }
                    </ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="navbar-text text-white me-3">@User.Identity.Name (@(User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Bibliotecario") ? "Bibliotecario" : "Usuario"))</span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
