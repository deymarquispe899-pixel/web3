@{
    ViewData["Title"] = "Dashboard - Bibliotecario";
}
<h2>Panel del Bibliotecario</h2>
<p class="text-muted">Bienvenido/a, @User.Identity!.Name</p>

<div class="row g-3 mt-2">
    <div class="col-md-6">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Libros</h5>
                <p class="card-text">Gestionar el catálogo de libros: agregar, editar y eliminar.</p>
                <a asp-controller="Libros" asp-action="Index" class="btn btn-light">Ir a Libros</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5 class="card-title">Préstamos</h5>
                <p class="card-text">Registrar nuevos préstamos y procesar devoluciones.</p>
                <a asp-controller="Prestamos" asp-action="Index" class="btn btn-light">Ir a Préstamos</a>
            </div>
        </div>
    </div>
</div>
