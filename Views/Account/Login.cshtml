@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar sesión - Biblioteca UV Sucre</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
        <div class="card shadow-sm" style="max-width:420px; width:100%;">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Biblioteca UV Sucre</h3>
                <p class="text-muted text-center">Universidad Privada del Valle - Sede Sucre</p>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                </form>

                <hr />
                <p class="small text-muted mb-0">Usuarios de prueba (creados automáticamente):</p>
                <ul class="small text-muted">
                    <li>admin@uvsucre.edu.bo / Admin123!</li>
                    <li>bibliotecario@uvsucre.edu.bo / Biblio123!</li>
                    <li>usuario@uvsucre.edu.bo / Usuario123!</li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
