@model IEnumerable<UsuarioListItemViewModel>
@{
    ViewData["Title"] = "Usuarios";
}
<h2>Gestión de Usuarios</h2>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo usuario</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var usuario in Model)
    {
        <tr>
            <td>@usuario.NombreCompleto</td>
            <td>@usuario.Email</td>
            <td><span class="badge bg-info text-dark">@usuario.Rol</span></td>
            <td>
                <form asp-action="Delete" asp-route-id="@usuario.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar este usuario?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
