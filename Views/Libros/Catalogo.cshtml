@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Catálogo de libros";
}
<h2>Catálogo de libros</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Titulo)</th>
            <th>@Html.DisplayNameFor(m => m.Autor)</th>
            <th>@Html.DisplayNameFor(m => m.Categoria)</th>
            <th>@Html.DisplayNameFor(m => m.CantidadDisponible)</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var libro in Model)
    {
        <tr>
            <td>@libro.Titulo</td>
            <td>@libro.Autor</td>
            <td>@libro.Categoria</td>
            <td>
                @if (libro.CantidadDisponible > 0)
                {
                    <span class="badge bg-success">Disponible (@libro.CantidadDisponible)</span>
                }
                else
                {
                    <span class="badge bg-secondary">Sin ejemplares</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
